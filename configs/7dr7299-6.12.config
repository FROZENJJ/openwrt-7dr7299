# 25.12-based MT7992 preview. Applied after the common package selections.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tplink_tl-7dr7299-v1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_USE_APK is not set
CONFIG_PACKAGE_opkg=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="25.12-SNAPSHOT"

# TL-7DR7299 v1 has external PA/LNA on both MT7992 bands.
CONFIG_MTK_WIFI7_FIRST_IF_EPAELNA=y
# CONFIG_MTK_WIFI7_FIRST_IF_IPAILNA is not set
CONFIG_MTK_WIFI7_SECOND_IF_EPAELNA=y
# CONFIG_PACKAGE_kmod-mt7996e is not set
# CONFIG_PACKAGE_kmod-mt7992-firmware is not set
# CONFIG_PACKAGE_kmod-mt7996-firmware is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
